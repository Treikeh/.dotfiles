; VARIABLES

(deflisten music_listen :initial "" "playerctl --follow metadata --format '{{ artist }} - {{ title }}' || true")

(defpoll time_poll :interval "30s" "date '+%H:%M - %d, %b %Y'")
(defpoll volume_poll :interval "5s" "scripts/getvol")
(defpoll thermal_poll :interval "5s" "scripts/thermal_info")



; GENERIC MODULES

(defwidget metric_module [label value onchange]
    (box :class "metric_module"
        :orientation "h"
        :space-evenly false
        (box :class "label" label)
        (label :text "${value}%")
        (scale
            :min 0
            :max 101
            :active {onchange != ""}
            :value value
            :onchange onchange
        )
    )
)

(defwidget icon_module [icon ?visible]
    (box :class "icon_module"
        :orientation "h"
        :halign "end"
        :space-evenly false
        :visible {visible ?: true} ; because the argument is optional
        (label :class "icon-module__icon" :text "${icon}")
        (children)
    )
)



; BAR

(defwindow bar
    :monitor "eDP-1"
    :stacking "fg"
    :exclusive true
    :geometry (geometry :x 0 :y 0 :width "100%" :height "1%" :anchor "top center")
    :reserve (struts :side "top" :distance "100px")
    (bar)
)


(defwidget bar []
    (centerbox :class "bar"
        :orientation "h"
        ;(hypr_workspaces)
        (apps)
        (music)
        (sidestuff)
    )
)

(defwidget sidestuff []
    (box :class "sidestuff"
        :orientation "h"
        :halign "end"
        :space-evenly false 
        (cpu_temp)
        (cpu_percent)
        (ram_percent)
        (audio)
        (metric_module :label ""
            :value {EWW_BATTERY["BAT1"].capacity}
            :onchange ""
        )
        (systray :class "systray")
        time_poll
    )
)

(defwidget apps []
    (box :class "apps"
        :orientation "h"
        :halign "start"
        (button :onclick "~/.config/eww/scripts/launch_fuzzel" "")
    )
)

(defwidget music []
    (box :class "music"
        :orientation "h"
        :space-evenly false
        :halign "center"
        {music_listen != "" ? "🎵${music_listen}" : ""}
    )
)

(defwidget audio []
    (box :class "audio"
        :orientation "h"
        :halign "start"
        :spacing 1
        :space-evenly false
        (button :onclick "~/.config/eww/scripts/launch_pavucontrol" "")
        (metric_module :label ""
            :value volume_poll
            :onchange "pamixer --set-volume {}"
        )
    )
)

(defwidget hypr_workspaces []
    (box :class "workspaces"
        :orientation "h"
        :space-evenly false
        :halign "start"
        :spacing 10
        (button :onclick "hyprctl dispatch workspace 1" 1)
        (button :onclick "hyprctl dispatch workspace 2" 2)
        (button :onclick "hyprctl dispatch workspace 3" 3)
        (button :onclick "hyprctl dispatch workspace 4" 4)
    )
)

(defwidget cpu_temp []
    (icon_module :class "cpu_temp"
        :icon "" 
        (label :text thermal_poll)
    )
)

(defwidget cpu_percent []
    (icon_module :class "cpu_percent"
        :icon "" 
        (label :text "${round(EWW_CPU.avg, 0)}%")
    )
)

(defwidget ram_percent []
    (icon_module :class "ram_percent"
        :icon "" 
        (label :text "${round(EWW_RAM.used_mem_perc, 0)}%")
    )
)


; BACKGROUND

(defwindow background
    :monitor "eDP-1"
    :stacking "bg"
    :geometry (geometry :width "100%" :height "96%")
    (box ;:style "background-image: url('./wallpaper.png')"
        (mirror_screen_button)
        (power_buttons)
    )
)

(defwindow background_hdmi
    :monitor "HDMI-A-1"
    :stacking "bg"
    :geometry (geometry :width "100%" :height "100%")
    (box ;:style "background-image: url('./wallpaper.png')"
        (power_buttons)
    )
)


(defwidget power_buttons []
    (box :class "power_buttons_box" :spacing 15
        :vexpand true :hexpand true
        :valign "end" :halign "end"
        :space-evenly true
        (button :onclick "poweroff" "⏻")
        (button :onclick "reboot" "")
    )
)

(defwidget mirror_screen_button []
    (box :class "mirror_screen_button_box"
        :vexpand true :hexpand true
        :valign "end" :halign "start"
        (button :onclick "~/.config/eww/scripts/mirror_laptop_screen" "")
    )
)